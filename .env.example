# Demo credentials, used by the one-click demo login buttons on /login.
# Leave a pair blank to hide that button. Nothing sensitive is committed here
# because these are throwaway demo accounts.
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL="noman2@gmail.com"
NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD="thisisasecurepassword"

NEXT_PUBLIC_DEMO_PROVIDER_EMAIL="noman6@gmail.com"
NEXT_PUBLIC_DEMO_PROVIDER_PASSWORD="thisisasecurepassword"

NEXT_PUBLIC_DEMO_ADMIN_EMAIL="admin@gmail.com"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="admin@123"

# Google Sign-In. Must match GOOGLE_CLIENT_ID in the backend .env.
# Leave blank to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Canonical and OpenGraph base URL for production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI features (search suggestions, personalised recommendations, chat assistant).
# All server-side only, never exposed to the browser.
#
# Providers are tried in the order listed below. The first one that answers wins.
# Any provider without a key is skipped, so you can add keys one at a time and
# stop whenever you like. With no keys at all the app still works and falls back
# to deterministic local answers.
#
#   GEMINI_API_KEY   https://aistudio.google.com/apikey
#   GROQ_API_KEY     https://console.groq.com/keys
#   OPENROUTER_API_KEY https://openrouter.ai/keys
#   NVIDIA_API_KEY   https://build.nvidia.com/settings/api-keys
#   MISTRAL_API_KEY  https://console.mistral.ai/api-keys

GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
NVIDIA_API_KEY=""
MISTRAL_API_KEY=""

# Optional: override the model list. Comma-separated, tried in order, so a
# retired model degrades to the next one instead of becoming an outage.
# To list what your own key can actually call:
#   curl "https://generativelanguage.googleapis.com/v1beta/models" -H "x-goog-api-key: $GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.8-flash,gemini-3.7-flash"
# GROQ_MODEL="llama-3.3-70b-versatile"
# OPENROUTER_MODEL="google/gemma-4-31b-it:free"
# NVIDIA_MODEL="google/gemma-4-31b-it"
# MISTRAL_MODEL="mistral-small-latest"